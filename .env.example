# Public site URL used for canonical links, sitemap.xml, and robots.txt
NEXT_PUBLIC_SITE_URL=https://example.com

# Form submission endpoint (JSON POST). Compatible with Formspree, Web3Forms, Basin, or a custom API route.
# Leave empty during development to keep honest Demo Mode enabled (never fakes a sent message).
NEXT_PUBLIC_INQUIRY_ENDPOINT=

# Optional direct contact email. When provided, Demo Mode and the contact block offer a pre-filled mailto fallback.
NEXT_PUBLIC_CONTACT_EMAIL=
